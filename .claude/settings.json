{
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Bash(git switch *)",
      "Bash(bash -n *)",
      "Bash(bash araclar/ortam_kur.sh *)",
      "Bash(python3 testler/referans/dogrula.py)",
      "Bash(python3 testler/referans/dogrula.py --hizli)",
      "Bash(python -m beyin.harness *)",
      "Bash(python3 -m beyin.harness *)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(python3 -m pytest *)",
      "Bash(python3 -m py_compile *)"
    ],
    "ask": [
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git push *)",
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Edit(./is_emri/**)",
      "Edit(./ref_katalog/**)",
      "Edit(./ref_yan/**)",
      "Edit(./beyin/veri/**)",
      "Edit(./beyin/testler/**)",
      "Edit(./KARARLAR/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/hooks/**)"
    ],
    "deny": [
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(rsync *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main *)",
      "Bash(git push * main)",
      "Read(./.env)",
      "Read(./**/*.env)",
      "Read(./kanal/settings.json)",
      "Read(./kanal/api_token.txt)",
      "Read(./kanal/state.json)",
      "Read(./kanal/durum/**)",
      "Read(./kanal/lib.snapshot.php)",
      "Read(~/.ssh/**)",
      "Edit(./.env)",
      "Edit(./**/*.env)",
      "Edit(./kanal/settings.json)",
      "Edit(./kanal/api_token.txt)",
      "Edit(./SHA256SUMS)",
      "Edit(./KARARLAR.md)",
      "Edit(./testler/referans/2026-*/**)",
      "Edit(./hosting/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/sir_koruma.py\"",
            "timeout": 20,
            "statusMessage": "Sır ve dondurulmuş dosya denetimi"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/muhur_koruma.py\" duzenleme",
            "timeout": 20,
            "statusMessage": "Mühürlü konular denetimi"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/komut_koruma.py\"",
            "timeout": 20,
            "statusMessage": "Komut freni"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/muhur_koruma.py\" komut",
            "timeout": 20,
            "statusMessage": "Mühürlü konular denetimi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/hizli_kontrol.py\"",
            "timeout": 60,
            "statusMessage": "Sözdizimi denetimi"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/muhur_koruma.py\" komut_sonu",
            "timeout": 20,
            "statusMessage": "Mühürlü konular denetimi"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/muhur_koruma.py\" oturum",
            "timeout": 20,
            "statusMessage": "Mühürlü konular listesi"
          }
        ]
      }
    ]
  },
  "outputStyle": "Explanatory"
}

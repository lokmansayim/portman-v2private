+# --- v1.2-deneme: serbest aks (K16-b). İş Emri'nde yapi.aks_cm varsa akslar bu listeden okunur; yoksa v1.1 ile birebir.
+_AKS = {"x": None, "y": None}
+
+
+def aks_ayarla(x=None, y=None):
+    """Serbest aks listelerini ayarla (cm; yarım-pano indeksi k ↔ liste[k]). None → düzenli 125,5 modül."""
+    _AKS["x"] = [float(v) for v in x] if x else None
+    _AKS["y"] = [float(v) for v in y] if y else None
+
+
+def _aks_deger(liste, k2):
+    k = int(round(k2))
+    if abs(k2 - k) < 1e-9:
+        return liste[k]
+    lo = int(math.floor(k2)); f = k2 - lo
+    return liste[lo] + (liste[lo + 1] - liste[lo]) * f
+
+
 def X(i: float) -> float:
     """Düşey aks: dış duvar iç yüzünden başlar (kısa kenar yönü, köşe 10 cm)."""
+    if _AKS["x"] is not None:
+        return _aks_deger(_AKS["x"], 2 * i)
     return 10.0 + MOD * i
 
 
 def Y(j: float) -> float:
     """Yatay aks: ön duvar orta eksenidir (uzun kenar yönü, köşe 5 cm)."""
+    if _AKS["y"] is not None:
+        return _aks_deger(_AKS["y"], 2 * j)
     return 5.0 + MOD * j
 
 

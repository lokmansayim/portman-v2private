{
  "version": "7.3",
  "screens": [
    {
      "id": "STANDART_P",
      "title": "Standart özellikler",
      "terminal": true,
      "success": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "Standart özellikler seçili gelir. Değiştirmek istediğinizi seçin, sonra Gönder'e basın."
          },
          {
            "type": "Dropdown",
            "name": "kaplama",
            "label": "Çatı kaplaması",
            "required": true,
            "init-value": "trapez",
            "data-source": [
              {
                "id": "trapez",
                "title": "Trapez sac (standart)"
              },
              {
                "id": "kiremit",
                "title": "Kiremit desen sac + OSB"
              },
              {
                "id": "tek_kat",
                "title": "Tek kat panel"
              },
              {
                "id": "shingle",
                "title": "Shingle + OSB"
              },
              {
                "id": "sandvic",
                "title": "Sandviç panel"
              }
            ]
          },
          {
            "type": "Dropdown",
            "name": "cati_rengi",
            "label": "Çatı rengi",
            "required": true,
            "init-value": "antrasit",
            "data-source": [
              {
                "id": "antrasit",
                "title": "Antrasit gri (standart)"
              },
              {
                "id": "kirmizi",
                "title": "Kırmızı (RAL 3009)"
              }
            ]
          },
          {
            "type": "Dropdown",
            "name": "yukseklik",
            "label": "Pano yüksekliği",
            "required": true,
            "init-value": "250",
            "data-source": [
              {
                "id": "250",
                "title": "250 cm (standart)"
              },
              {
                "id": "280",
                "title": "280 cm"
              },
              {
                "id": "300",
                "title": "300 cm"
              }
            ]
          },
          {
            "type": "Dropdown",
            "name": "dis_duvar",
            "label": "Dış duvar",
            "required": true,
            "init-value": "100",
            "data-source": [
              {
                "id": "100",
                "title": "100 mm (standart)"
              },
              {
                "id": "160",
                "title": "160 mm"
              }
            ]
          },
          {
            "type": "Dropdown",
            "name": "ic_duvar",
            "label": "İç duvar",
            "required": true,
            "init-value": "60",
            "data-source": [
              {
                "id": "60",
                "title": "60 mm (standart)"
              },
              {
                "id": "100",
                "title": "100 mm"
              }
            ]
          },
          {
            "type": "Dropdown",
            "name": "tavan",
            "label": "Tavan",
            "required": true,
            "init-value": "asma",
            "data-source": [
              {
                "id": "asma",
                "title": "Asma tavan (standart)"
              },
              {
                "id": "ters",
                "title": "Ters tavan"
              }
            ]
          },
          {
            "type": "Dropdown",
            "name": "pencere_rengi",
            "label": "Pencere rengi",
            "required": true,
            "init-value": "beyaz",
            "data-source": [
              {
                "id": "beyaz",
                "title": "Beyaz (standart)"
              },
              {
                "id": "antrasit",
                "title": "Antrasit gri"
              }
            ]
          },
          {
            "type": "CheckboxGroup",
            "name": "ek",
            "label": "Ek istekler",
            "required": false,
            "data-source": [
              {
                "id": "alcipan",
                "title": "İç duvarda alçıpan kaplama"
              },
              {
                "id": "lata",
                "title": "Lata ve yalı baskı",
                "description": "H profilde lata, köşelerde yalı baskı"
              },
              {
                "id": "cift_yun",
                "title": "Çatıda çift kat mineral yün"
              }
            ]
          },
          {
            "type": "TextInput",
            "name": "musteri",
            "label": "Müşteri / proje adı",
            "input-type": "text",
            "required": false
          },
          {
            "type": "TextInput",
            "name": "il",
            "label": "Teslim ili",
            "input-type": "text",
            "required": false
          },
          {
            "type": "TextInput",
            "name": "ilce",
            "label": "Teslim ilçesi",
            "input-type": "text",
            "required": false
          },
          {
            "type": "Footer",
            "label": "Gönder",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "kaplama": "${form.kaplama}",
                "cati_rengi": "${form.cati_rengi}",
                "yukseklik": "${form.yukseklik}",
                "dis_duvar": "${form.dis_duvar}",
                "ic_duvar": "${form.ic_duvar}",
                "tavan": "${form.tavan}",
                "pencere_rengi": "${form.pencere_rengi}",
                "ek": "${form.ek}",
                "musteri": "${form.musteri}",
                "il": "${form.il}",
                "ilce": "${form.ilce}"
              }
            }
          }
        ]
      }
    }
  ]
}
